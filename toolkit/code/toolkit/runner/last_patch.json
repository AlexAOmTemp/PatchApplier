[{"id": "t3", "action": "replace_in_file",
  "arguments": {"file_path": "toolkit/code/manual/_probe_tier.py",
                "search": "x = 999",
                "replace": "x = 0"}}]

[{"id": "t4", "action": "replace_in_file",
