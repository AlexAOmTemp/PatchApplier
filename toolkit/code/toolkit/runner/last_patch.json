                "numbered": true, "escape": "perline"}}]

[{"id": "del", "action": "delete_file",
  "arguments": {"file_path": "toolkit/code/manual/_probe_tier.py"}}]

[{"id": "rm-script", "action": "delete_file",
  "arguments": {"file_path": "toolkit/code/manual/_probe_tier.py"}}]

[{"id": "rm-metrics", "action": "delete_file",
