[{"id": "commit", "action": "run_python",
  "arguments": {"script": "toolkit/code/manual/_git.py",
                "args": ["commit", "checkpoint: before MVP step 3a (gui refactor)"]}}]

[{"id": "grep-session", "action": "grep",
  "arguments": {"pattern": "_session|msg_queue|_session_lock|_session_backend_name",
                "paths": ["toolkit/code/toolkit/runner/gui/app.py"],
                "fixed_strings": false, "max_results": 50}}]

[{"id": "grep-worker", "action": "grep",
  "arguments": {"pattern": "^def worker|^def _run_patch|^def _start_session_in_background",
                "paths": ["toolkit/code/toolkit/runner/gui/app.py"]}}]

[{"id": "read-worker", "action": "read_unit",
  "arguments": {"file_path": "toolkit/code/toolkit/runner/gui/app.py",
                "address": {"qualname": "worker"}}}]